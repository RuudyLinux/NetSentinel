# SP6 target image. Not the slice-1 development path — see docker-compose.yml and
# README.md for local development, which runs uvicorn directly via `uv run`.
FROM python:3.13-slim

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY backend/ backend/
WORKDIR /app/backend

RUN uv sync --frozen

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
