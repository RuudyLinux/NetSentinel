NETSENTINEL_JWT_SECRET=replace-with-openssl-rand-hex-32
# Local dev default. For Postgres: postgresql+psycopg://user:pass@host:5432/dbname
# (see docker-compose.yml for the containerized stack's actual values).
NETSENTINEL_DATABASE_URL=sqlite:///./var/netsentinel.db
# development | test | production. Only "production" enforces the JWT secret check
# below (see app/config.py) — startup fails closed if the secret is missing/weak.
NETSENTINEL_ENVIRONMENT=development

# local (default) | s3 — see app/storage/registry.py. The s3_* settings below are
# only read when NETSENTINEL_STORAGE_BACKEND=s3; leave s3_endpoint_url unset to
# target real AWS S3 rather than a self-hosted S3-compatible endpoint like MinIO.
NETSENTINEL_STORAGE_BACKEND=local
# NETSENTINEL_S3_BUCKET=netsentinel
# NETSENTINEL_S3_ENDPOINT_URL=http://localhost:9000
# NETSENTINEL_S3_ACCESS_KEY=netsentinel
# NETSENTINEL_S3_SECRET_KEY=netsentinel-dev-only
# NETSENTINEL_S3_REGION=us-east-1
